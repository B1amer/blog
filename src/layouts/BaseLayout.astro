---
import { SITE_TITLE, SITE_SUBTITLE, SITE_DESCRIPTION, GITHUB_URL } from '../consts';
import { withBase } from '../utils/posts';

interface Props {
  title?: string;
  description?: string;
}

const { title = SITE_TITLE, description = SITE_DESCRIPTION } = Astro.props;
const fullTitle = title === SITE_TITLE ? `${SITE_TITLE} · ${SITE_SUBTITLE}` : `${title} | ${SITE_TITLE}`;
const currentPath = Astro.url.pathname;
const homeUrl = withBase('/');
const archivesUrl = withBase('/archives/');
const tagsUrl = withBase('/tags/');
const rssUrl = withBase('/rss.xml');
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase('/images/favicon32.png')} />
    <link rel="icon" type="image/png" sizes="16x16" href={withBase('/images/favicon16.png')} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={rssUrl} />
    <style is:global>
      :root {
        --bg: #faf9f6;
        --surface: #ffffff;
        --text: #1c1917;
        --text-secondary: #57534e;
        --text-muted: #a8a29e;
        --border: #e7e5e4;
        --accent: #0f172a;
        --tag-bg: #f5f5f4;
        --code-bg: #f5f5f4;
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #0c0a09;
          --surface: #1c1917;
          --text: #f5f5f4;
          --text-secondary: #a8a29e;
          --text-muted: #78716c;
          --border: #292524;
          --accent: #e7e5e4;
          --tag-bg: #1c1917;
          --code-bg: #1c1917;
        }
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        background-color: var(--bg);
        color: var(--text);
        font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Noto Sans SC", sans-serif;
        line-height: 1.8;
        font-size: 16px;
        -webkit-font-smoothing: antialiased;
      }

      a {
        color: inherit;
        text-decoration: none;
        transition: opacity 0.15s ease;
      }

      a:hover {
        opacity: 0.7;
      }

      .container {
        max-width: 760px;
        margin: 0 auto;
        padding: 0 24px;
      }

      header.site-header {
        padding: 40px 0 28px;
        border-bottom: 1px solid var(--border);
        margin-bottom: 40px;
      }

      .header-inner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 14px;
      }

      .brand-avatar {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        object-fit: cover;
        border: 1px solid var(--border);
      }

      .brand-title {
        font-size: 1.25rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        line-height: 1.3;
      }

      .brand-subtitle {
        font-size: 0.82rem;
        color: var(--text-secondary);
      }

      nav.site-nav {
        display: flex;
        gap: 24px;
        font-size: 0.92rem;
        color: var(--text-secondary);
      }

      nav.site-nav a.active {
        color: var(--text);
        font-weight: 600;
      }

      main {
        min-height: 65vh;
      }

      footer.site-footer {
        margin-top: 72px;
        padding: 32px 0 48px;
        border-top: 1px solid var(--border);
        font-size: 0.85rem;
        color: var(--text-muted);
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
      }

      /* Markdown Article Content Styling */
      .prose {
        font-size: 1.02rem;
        line-height: 1.85;
        color: var(--text);
      }

      .prose h1,
      .prose h2,
      .prose h3,
      .prose h4 {
        margin-top: 2.2em;
        margin-bottom: 0.8em;
        font-weight: 700;
        line-height: 1.35;
        letter-spacing: -0.01em;
      }

      .prose h1 {
        font-size: 1.55rem;
        padding-bottom: 0.3em;
        border-bottom: 1px solid var(--border);
      }

      .prose h2 {
        font-size: 1.32rem;
      }

      .prose h3 {
        font-size: 1.14rem;
      }

      .prose p {
        margin-bottom: 1.35em;
      }

      .prose a {
        text-decoration: underline;
        text-underline-offset: 4px;
        decoration-color: var(--text-muted);
      }

      .prose blockquote {
        margin: 1.6em 0;
        padding: 0.6em 1.2em;
        border-left: 3px solid var(--text);
        background: var(--tag-bg);
        color: var(--text-secondary);
        border-radius: 0 6px 6px 0;
      }

      .prose blockquote p:last-child {
        margin-bottom: 0;
      }

      .prose ul,
      .prose ol {
        margin: 1em 0 1.4em 1.5em;
      }

      .prose li {
        margin-bottom: 0.45em;
      }

      .prose hr {
        border: 0;
        border-top: 1px solid var(--border);
        margin: 2.4em 0;
      }

      .prose img {
        max-width: 100%;
        height: auto;
        border-radius: 8px;
        margin: 1.2em 0;
        border: 1px solid var(--border);
        display: block;
      }

      .prose code {
        font-family: "JetBrains Mono", Consolas, Monaco, monospace;
        font-size: 0.88em;
        background: var(--code-bg);
        padding: 0.2em 0.4em;
        border-radius: 4px;
      }

      .prose pre {
        padding: 16px;
        border-radius: 8px;
        overflow-x: auto;
        margin: 1.5em 0;
      }

      .prose pre code {
        background: none;
        padding: 0;
      }

      .tag-badge {
        display: inline-block;
        font-size: 0.78rem;
        padding: 2px 10px;
        border-radius: 999px;
        background: var(--tag-bg);
        color: var(--text-secondary);
        border: 1px solid var(--border);
      }
    </style>
  </head>
  <body>
    <div class="container">
      <header class="site-header">
        <div class="header-inner">
          <a href={homeUrl} class="brand">
            <img src={withBase('/uploads/avatar.png')} alt="Blarmer" class="brand-avatar" />
            <div>
              <div class="brand-title">{SITE_TITLE}</div>
              <div class="brand-subtitle">{SITE_SUBTITLE}</div>
            </div>
          </a>
          <nav class="site-nav">
            <a href={homeUrl} class={currentPath === homeUrl ? 'active' : ''}>首页</a>
            <a href={archivesUrl} class={currentPath.startsWith(archivesUrl) ? 'active' : ''}>归档</a>
            <a href={tagsUrl} class={currentPath.startsWith(tagsUrl) ? 'active' : ''}>标签</a>
            <a href={rssUrl}>RSS</a>
            <a href={GITHUB_URL} target="_blank" rel="noopener">GitHub</a>
          </nav>
        </div>
      </header>

      <main>
        <slot />
      </main>

      <footer class="site-footer">
        <div>&copy; 2017 – {new Date().getFullYear()} Blarmer</div>
        <div>常现贪嗔痴慢疑，方了仁义礼智信</div>
      </footer>
    </div>
  </body>
</html>
