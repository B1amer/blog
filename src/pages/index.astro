---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPostUrl, formatDate, withBase } from '../utils/posts';
import { SITE_DESCRIPTION } from '../consts';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

function getExcerpt(body?: string): string {
  if (!body) return '';
  return body
    .replace(/!\[.*?\]\(.*?\)/g, '')
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
    .replace(/[#>*`~_-]/g, '')
    .replace(/\s+/g, ' ')
    .trim()
    .slice(0, 140);
}
---

<BaseLayout>
  <section class="intro-quote">
    <p>{SITE_DESCRIPTION}</p>
  </section>

  <section class="post-list">
    {
      posts.map((post) => (
        <article class="post-card">
          <div class="post-meta">
            <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
            {post.data.tags.map((tag) => (
              <a href={withBase(`/tags/${tag}/`)} class="tag-badge">#{tag}</a>
            ))}
          </div>
          <h2 class="post-title">
            <a href={getPostUrl(post)}>{post.data.title}</a>
          </h2>
          <p class="post-excerpt">{getExcerpt(post.body)}...</p>
        </article>
      ))
    }
  </section>
</BaseLayout>

<style>
  .intro-quote {
    padding: 18px 22px;
    background: var(--tag-bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    margin-bottom: 40px;
    font-size: 0.92rem;
    color: var(--text-secondary);
  }

  .post-list {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .post-card {
    padding-bottom: 32px;
    border-bottom: 1px solid var(--border);
  }

  .post-card:last-child {
    border-bottom: none;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.84rem;
    color: var(--text-muted);
    margin-bottom: 6px;
  }

  .post-title {
    font-size: 1.35rem;
    font-weight: 700;
    margin-bottom: 8px;
    line-height: 1.4;
  }

  .post-excerpt {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.75;
  }
</style>
