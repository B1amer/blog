---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/posts';
---

<BaseLayout title="404 Not Found">
  <div style="padding: 60px 0; text-align: center;">
    <h1 style="font-size: 3rem; margin-bottom: 12px;">404</h1>
    <p style="color: var(--text-secondary); margin-bottom: 24px;">页面不存在或已迁移</p>
    <a href={withBase('/')} class="tag-badge" style="padding: 8px 18px; font-size: 0.9rem;">返回首页</a>
  </div>
</BaseLayout>
