---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPostUrl, formatDate } from '../../utils/posts';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

type PostList = typeof posts;
const groupedByYear: Record<number, PostList> = {};
for (const post of posts) {
  const year = post.data.pubDate.getUTCFullYear();
  if (!groupedByYear[year]) groupedByYear[year] = [];
  groupedByYear[year].push(post);
}

const years = Object.keys(groupedByYear)
  .map(Number)
  .sort((a, b) => b - a);
---

<BaseLayout title="归档">
  <h1 class="page-title">文章归档 ({posts.length})</h1>
  {
    years.map((year) => (
      <section class="year-group">
        <h2 class="year-heading">{year}</h2>
        <ul class="archive-list">
          {groupedByYear[year].map((post) => (
            <li class="archive-item">
              <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate).slice(5)}</time>
              <a href={getPostUrl(post)}>{post.data.title}</a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</BaseLayout>

<style>
  .page-title {
    font-size: 1.5rem;
    margin-bottom: 32px;
  }

  .year-group {
    margin-bottom: 36px;
  }

  .year-heading {
    font-size: 1.2rem;
    margin-bottom: 14px;
    color: var(--text-secondary);
    border-bottom: 1px solid var(--border);
    padding-bottom: 6px;
  }

  .archive-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .archive-item {
    display: flex;
    align-items: baseline;
    gap: 18px;
  }

  .archive-item time {
    font-family: monospace;
    font-size: 0.88rem;
    color: var(--text-muted);
    flex-shrink: 0;
  }
</style>
